{
  "name": "chesse-discord-bot",
  "version": "0.1.0",
  "private": true,
  "description": "A cheese-themed Discord chess bot built with Components v2 and Canvas.",
  "type": "module",
  "scripts": {
    "start": "node src/index.js",
    "dev": "node --watch src/index.js",
    "activity:build": "vite build --config activity/vite.config.js && node scripts/build-activity-assets.js",
    "activity:start": "node src/activity/server.js",
    "activity:preview": "node scripts/preview-activity.js",
    "register": "node scripts/register-commands.js",
    "emojis:upload": "node scripts/upload-emojis.js",
    "assets:prepare": "npm run assets:build",
    "assets:build": "node scripts/extract-chess-pieces.js && node scripts/export-emojis.js && node scripts/preview-thumbnails.js && node scripts/preview-logos.js && node scripts/preview-board.js && node scripts/validate-assets.js",
    "assets:pieces": "node scripts/extract-chess-pieces.js",
    "assets:emojis": "node scripts/export-emojis.js",
    "assets:validate": "node scripts/validate-assets.js",
    "preview": "node scripts/preview-board.js",
    "test": "node --test"
  },
  "engines": {
    "node": ">=22.12.0"
  },
  "dependencies": {
    "@discord/embedded-app-sdk": "^2.5.0",
    "@napi-rs/canvas": "^1.0.11",
    "chess.js": "^1.4.0",
    "discord.js": "^14.25.1",
    "dotenv": "^17.2.2",
    "express": "^5.3.0",
    "express-rate-limit": "^8.7.1"
  },
  "devDependencies": {
    "vite": "^8.3.4"
  }
}
